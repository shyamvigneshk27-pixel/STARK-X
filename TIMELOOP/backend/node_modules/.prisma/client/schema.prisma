// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum TripStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum TripType {
  ADVENTURE
  CULTURAL
  BEACH
  BUSINESS
  FAMILY
  HONEYMOON
  BUDGET
  LUXURY
  ROAD_TRIP
  SOLO
}

enum BudgetPreference {
  BUDGET
  MODERATE
  COMFORT
  LUXURY
}

enum SectionType {
  ACCOMMODATION
  TRANSPORT
  ACTIVITY
  FOOD
  OTHER
}

enum ExpenseCategory {
  ACCOMMODATION
  TRANSPORT
  FOOD
  ACTIVITY
  SHOPPING
  HEALTH
  ENTERTAINMENT
  OTHER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  city          String?
  country       String?
  bio           String?
  avatarUrl     String?
  role          UserRole  @default(USER)
  isVerified    Boolean   @default(false)
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trips             Trip[]
  checklists        PackingChecklist[]
  notes             TripNote[]
  invoices          Invoice[]
  sharedItineraries SharedItinerary[]

  @@map("users")
}

model Trip {
  id               String           @id @default(cuid())
  userId           String
  title            String
  description      String?
  type             TripType         @default(ADVENTURE)
  travelersCount   Int              @default(1)
  budgetPreference BudgetPreference @default(MODERATE)
  startDate        DateTime
  endDate          DateTime
  status           TripStatus       @default(DRAFT)
  coverImage       String?
  isPublic         Boolean          @default(false)
  shareSlug        String?          @unique
  totalBudgetGoal  Float?
  currency         String           @default("USD")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops           TripStop[]
  budget          Budget?
  expenses        Expense[]
  checklist       PackingChecklist?
  notes           TripNote[]
  sharedItinerary SharedItinerary?
  invoices        Invoice[]

  @@map("trips")
}

model TripStop {
  id            String    @id @default(cuid())
  tripId        String
  cityName      String
  cityCode      String?
  country       String?
  countryCode   String?
  lat           Float?
  lng           Float?
  order         Int       @default(0)
  arrivalDate   DateTime?
  departureDate DateTime?
  imageUrl      String?
  createdAt     DateTime  @default(now())

  trip     Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sections ItinerarySection[]
  notes    TripNote[]

  @@map("trip_stops")
}

model ItinerarySection {
  id              String      @id @default(cuid())
  tripStopId      String
  title           String
  description     String?
  type            SectionType @default(ACTIVITY)
  date            DateTime?
  startTime       String?
  endTime         String?
  estimatedBudget Float?
  currency        String      @default("USD")
  order           Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tripStop   TripStop   @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("itinerary_sections")
}

model Activity {
  id            String   @id @default(cuid())
  sectionId     String
  name          String
  description   String?
  category      String?
  durationHours Float?
  cost          Float?
  currency      String   @default("USD")
  externalId    String?
  imageUrl      String?
  address       String?
  lat           Float?
  lng           Float?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  section ItinerarySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Budget {
  id             String   @id @default(cuid())
  tripId         String   @unique
  totalBudget    Float    @default(0)
  accommodation  Float    @default(0)
  transport      Float    @default(0)
  food           Float    @default(0)
  activities     Float    @default(0)
  miscellaneous  Float    @default(0)
  currency       String   @default("USD")
  autoCalculated Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model Expense {
  id          String          @id @default(cuid())
  tripId      String
  category    ExpenseCategory @default(OTHER)
  amount      Float
  currency    String          @default("USD")
  description String?
  date        DateTime        @default(now())
  receiptUrl  String?
  createdAt   DateTime        @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model PackingChecklist {
  id        String   @id @default(cuid())
  tripId    String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@map("packing_checklists")
}

model ChecklistItem {
  id              String   @id @default(cuid())
  checklistId     String
  category        String   @default("General")
  name            String
  isPacked        Boolean  @default(false)
  isOfflineSynced Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  checklist PackingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model TripNote {
  id        String   @id @default(cuid())
  tripId    String
  stopId    String?
  userId    String
  title     String?
  content   String
  isOffline Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip    TripStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
  tripRel Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trip_notes")
}

model SharedItinerary {
  id        String   @id @default(cuid())
  tripId    String   @unique
  userId    String
  shareSlug String   @unique @default(cuid())
  isActive  Boolean  @default(true)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shared_itineraries")
}

model Invoice {
  id            String   @id @default(cuid())
  tripId        String
  userId        String
  invoiceNumber String   @unique
  totalAmount   Float
  currency      String   @default("USD")
  breakdown     Json?
  pdfUrl        String?
  generatedAt   DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

# Traveloop Backend Environment Variables
# Copy this file to .env and fill in the values

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (Supabase PostgreSQL or local) ─────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/traveloop?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── GeoDB Cities (RapidAPI) ─────────────────────────────────────────────────
# Get free key at: https://rapidapi.com/wirefreethought/api/geodb-cities
GEODB_API_KEY=your_rapidapi_key
GEODB_API_HOST=wft-geo-db.p.rapidapi.com

# ─── OpenTripMap (Activities/POIs) ───────────────────────────────────────────
# Get free key at: https://opentripmap.io/register
OPENTRIPMAP_API_KEY=your_opentripmap_key

# ─── ExchangeRate API ────────────────────────────────────────────────────────
# Get free key at: https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=your_exchangerate_key

# ─── OpenWeatherMap (Optional) ───────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@traveloop.com

# ─── Client URL (for CORS) ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
